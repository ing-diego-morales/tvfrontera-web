# =====================================================================
#  Televentas Fest · Web — variables de entorno (archivo único)
# =====================================================================
#  ⚠️ NO escribas aquí claves reales: este archivo se sube a GitHub.
#     · En tu PC funciona tal cual (los secretos vacíos usan valores de desarrollo).
#     · En producción (Railway) los valores reales van en el panel de variables del hosting.
#  Las variables NEXT_PUBLIC_* se incluyen en el código del navegador: nunca pongas secretos en ellas.
# =====================================================================

# Dirección de la API vista DESDE EL SERVIDOR de Next (el navegador usa /api/* a través de la web).
# Se graba al compilar: si cambia en producción, vuelve a compilar.
# Railway: http://<servicio-api>.railway.internal:4000
API_INTERNA_URL=http://localhost:4000

# MISMO valor que REVALIDATE_SECRET de la API (vacío en desarrollo = valor automático)
REVALIDATE_SECRET=

# Dominio público del sitio (SEO, sitemap, legales). Producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (anti-robots opcional). Vacío = desactivado
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# true = compra directa por la web. Vacío = pedidos por WhatsApp ("Próximamente")
NEXT_PUBLIC_COMPRAS_WEB=

# true = mostrar la señal de TV en vivo
NEXT_PUBLIC_TV_EN_VIVO=
